rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owner(uid) { return signedIn() && request.auth.uid == uid; }
    function admin() {
      return signedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }
    match /users/{uid} {
      allow create: if owner(uid) &&
        request.resource.data.role in ["donor","member"] &&
        request.resource.data.keys().hasOnly(["name","email","phone","bloodGroup","division","district","upazila","address","photoURL","lastDonation","available","publicContact","role","createdAt","needsDonorProfile"]);
      allow read: if owner(uid) || admin();
      allow update: if (owner(uid) &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.email == resource.data.email &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(["name","phone","bloodGroup","division","district","upazila","address","photoURL","lastDonation","available","publicContact","needsDonorProfile"])) || admin();
      allow delete: if admin();
    }
    match /donorDirectory/{uid} {
      allow read: if true;
      allow create: if owner(uid) && request.resource.data.uid == uid &&
        request.resource.data.publicContact == true &&
        request.resource.data.keys().hasOnly(["uid","name","phone","bloodGroup","division","district","upazila","photoURL","available","lastDonation","publicContact","updatedAt"]);
      allow update: if (owner(uid) && request.resource.data.uid == resource.data.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(["name","phone","bloodGroup","division","district","upazila","photoURL","available","lastDonation","publicContact","updatedAt"])) || admin();
      allow delete: if owner(uid) || admin();
    }
    match /bloodRequests/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.createdBy == request.auth.uid &&
        request.resource.data.status == "active" && request.resource.data.publicContact == true &&
        request.resource.data.keys().hasOnly(["patientName","contact","bloodGroup","bags","division","district","upazila","hospital","requiredDate","details","status","publicContact","createdBy","createdAt"]);
      allow update: if admin() || (signedIn() && resource.data.createdBy == request.auth.uid &&
        request.resource.data.createdBy == resource.data.createdBy &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(["patientName","contact","bloodGroup","bags","division","district","upazila","hospital","requiredDate","details","status","publicContact"]));
      allow delete: if admin() || (signedIn() && resource.data.createdBy == request.auth.uid);
    }
    match /{document=**} { allow read, write: if false; }
  }
}